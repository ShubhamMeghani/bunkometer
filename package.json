{
  "name": "bunkometer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "drizzle-kit migrate && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
